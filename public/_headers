# Response headers for static assets (the React app). Workers Static Assets
# applies this file; API responses get theirs from worker/middleware.ts.
/*
  # Only load scripts, styles and data from this site, plus the few extras the
  # lab really uses: Turnstile (challenges.cloudflare.com), Cloudflare Web
  # Analytics (beacon from static.cloudflareinsights.com, data to
  # cloudflareinsights.com) and the Pages demo. Each directive is explained on
  # the Security page.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://cf-feature-lab-pages.pages.dev https://cloudflareinsights.com; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  # no-transform: Cloudflare must not modify these responses. Without it,
  # zone features inject their own scripts (JavaScript Detections, the Web
  # Analytics beacon, AI Labyrinth links…) and the CSP then blocks them. The
  # page you get is exactly what this repo ships. Web Analytics is installed
  # manually in index.html instead.
  Cache-Control: no-transform

# Hashed build output never changes, so browsers can cache it for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
