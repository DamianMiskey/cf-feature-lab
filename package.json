{
  "name": "cf-feature-lab",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm test && npm run build && wrangler deploy && npm run db:migrate:remote",
    "typecheck": "tsc -b",
    "cf-typegen": "wrangler types --env-file .dev.vars.example",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "types:check": "wrangler types --env-file .dev.vars.example --check",
    "e2e": "playwright test",
    "e2e:server": "E2E=1 vite build && wrangler d1 migrations apply DB --local --persist-to .wrangler/e2e-state && E2E=1 vite preview --port 4317 --strictPort"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.142",
    "@cloudflare/ai-chat": "^0.12.1",
    "@cloudflare/puppeteer": "^1.4.0",
    "agents": "^0.28.1",
    "ai": "^7.0.139",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "mimetext": "3.0.28",
    "pg": "^8.23.1",
    "postal-mime": "4.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@playwright/test": "1.64.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.3"
  }
}
